  "status": "design_only_not_run",
  "run_policy": "Run only on explicit instruction after the adapters exist. Synthetic inputs only.",
  "data_policy": {
    "textbook_content": false,
    "student_personal_data": false,
    "external_calls_made_by_this_file": 0
