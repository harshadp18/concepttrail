  "scoring_policy": "Deterministic checks only. No LLM scores anything. Educator review decides quality.",
  "providers": [
    {"provider": "ollama", "model": "qwen3.5:9b", "role": "primary", "options": {"num_ctx": 4096, "think": false}},
