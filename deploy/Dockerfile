# ConceptTrail FastAPI backend. No secrets and no private records are copied in: configuration
# is injected at run time and the authorization records are mounted read-only.
# Base pinned by digest (python 3.12.16, the version the test suite runs on).
FROM python:3.12.16-slim@sha256:8523d6abeb48ceae0b7240d30c5808fc26cb79c1a635bacdf19cf3baecfbec07

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app \
    CONCEPTTRAIL_AUTHORIZATION_DIR=/run/concepttrail/authorizations

WORKDIR /app
RUN useradd --create-home --uid 10001 concepttrail

# Exact, hash-verified dependency set (deploy/requirements.lock, generated by pip-compile).
COPY deploy/requirements.lock /tmp/requirements.lock
RUN pip install --require-hashes --no-deps -r /tmp/requirements.lock && rm /tmp/requirements.lock

COPY app ./app
# The purpose-specific rights gate (code only; standard library). Without mounted records every
# use is refused.
COPY data_pipeline/authorization.py ./data_pipeline/authorization.py

USER concepttrail
EXPOSE 8000
# --proxy-headers trusts X-Forwarded-* only from FORWARDED_ALLOW_IPS (default 127.0.0.1).
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
