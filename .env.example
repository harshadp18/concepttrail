# Copy to .env for local development. Never commit .env.
APP_NAME=ConceptTrail
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# PostgreSQL. Use URL-encoded credentials if password contains reserved URL characters.
DATABASE_URL=postgresql+psycopg://concepttrail_user:CHANGE_ME@localhost:5432/concepttrail_db
DB_SCHEMA=concepttrail

# Authentication secrets: generate separate long random values.
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
JWT_SECRET_KEY=CHANGE_ME_generate_a_different_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM router: provider identifiers are configurable; verify current provider model IDs and terms.
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_ENABLED=false
LLM_TIMEOUT_SECONDS=25
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_RETRIES=0

GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=SET_TO_A_MODEL_AVAILABLE_IN_YOUR_ACCOUNT

GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=openai/gpt-oss-120b

# Benchmark-only challenger; no production routing unless explicitly approved after evaluation.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=SET_AFTER_MODEL_BENCHMARK

# Embeddings are deliberately undecided until English/Hindi retrieval evaluation is run.
EMBEDDING_PROVIDER=SET_AFTER_BENCHMARK
EMBEDDING_MODEL_ID=SET_AFTER_BENCHMARK
# Keep DB VECTOR unbounded until this is selected and approved.
EMBEDDING_DIMENSIONS=SET_AFTER_BENCHMARK
EMBEDDING_DISTANCE_METRIC=cosine
VECTOR_BACKEND=pgvector
VECTOR_SCHEMA=concepttrail
VECTOR_TABLE=embedding_chunk

# Data paths (relative to repository root; raw files must remain private).
DATA_ROOT=data_pipeline/data
TEXTBOOK_ROOT=data_pipeline/data/raw/textbooks
EXTRACTED_JSON_ROOT=data_pipeline/data/interim/extracted_json
PROCESSED_JSON_ROOT=data_pipeline/data/processed/textbook_json

# Do not log request bodies by default.
LOG_REQUEST_BODIES=false
