# Copy to .env for local development. Never commit .env.
APP_NAME=ConceptTrail
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# PostgreSQL. Use URL-encoded credentials if password contains reserved URL characters.
DATABASE_URL=postgresql+psycopg://concepttrail_user:CHANGE_ME@localhost:5432/concepttrail_db
DB_SCHEMA=concepttrail

# Authentication secrets: generate separate long random values.
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
JWT_SECRET_KEY=CHANGE_ME_generate_a_different_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM providers (D-055). Primary: Qwen 3.5 9B served by a local Ollama. Fallback candidate:
# GPT-OSS 120B on Groq, DISABLED. Fallback may be enabled only after provider integration,
# security, privacy, reliability and fallback tests pass and the owner approves it.
# Gemini and DeepSeek are not part of the current architecture.
LLM_PRIMARY_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_ENABLED=false

LLM_TIMEOUT_SECONDS=120
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_RETRIES=0
LLM_TEMPERATURE=0.2

# Local Ollama (development). localhost is not reachable from a remotely deployed server:
# production needs a dedicated inference host reached over https or a private network.
# Never expose port 11434 publicly.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=4096
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=5m

# Groq cloud fallback candidate. The key is optional while fallback is disabled.
# Selecting Groq does not authorise sending textbook content or student data to it.
GROQ_API_KEY=CHANGE_ME
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings are deliberately undecided until English/Hindi retrieval evaluation is run.
EMBEDDING_PROVIDER=SET_AFTER_BENCHMARK
EMBEDDING_MODEL_ID=SET_AFTER_BENCHMARK
# Keep DB VECTOR unbounded until this is selected and approved.
EMBEDDING_DIMENSIONS=SET_AFTER_BENCHMARK
EMBEDDING_DISTANCE_METRIC=cosine
VECTOR_BACKEND=pgvector
VECTOR_SCHEMA=concepttrail
VECTOR_TABLE=embedding_chunk

# Data paths (relative to repository root; raw files must remain private).
DATA_ROOT=data_pipeline/data
TEXTBOOK_ROOT=data_pipeline/data/raw/textbooks
EXTRACTED_JSON_ROOT=data_pipeline/data/interim/extracted_json
PROCESSED_JSON_ROOT=data_pipeline/data/processed/textbook_json

# Do not log request bodies by default.
LOG_REQUEST_BODIES=false

# Content release. "production" serves only human-approved/published content. "demo" also
# serves AI-generated demo_release content and is refused unless APP_ENV is development/test.
CONTENT_RELEASE_MODE=production

# Features that need PROPOSED additive migrations (db/proposals/0002 and 0003). They answer
# 503 feature_not_enabled until the owner approves and applies the migrations; do not enable
# them against a database that lacks the tables.
INTERVENTIONS_ENABLED=false
NOTIFICATIONS_ENABLED=false
DOUBT_HISTORY_ENABLED=false
# Bell-Ringer cycles use the PROPOSED table in db/proposals/0004_bell_ringer_cycle.py. The read-only
# topic analysis and the class heatmap work without it. Flagging thresholds (provisional):
BELL_RINGER_ENABLED=false
BELL_RINGER_MIN_COVERAGE=0.3
BELL_RINGER_MIN_AFFECTED_LEARNERS=2
BELL_RINGER_MIN_AFFECTED_SHARE=0.4
BELL_RINGER_WINDOW_DAYS=14

# Rate limiting. "memory" is per process and allowed only outside production. Production
# requires RATE_LIMIT_BACKEND=redis and REDIS_URL (rediss://, or redis:// on a private network).
RATE_LIMIT_BACKEND=memory
REDIS_URL=SET_TO_REDIS_URL_WHEN_USING_REDIS
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_IP_MAX_FAILURES=50
DOUBT_REQUESTS_PER_HOUR=30

# HTTP surface. Comma-separated. CORS origins must be explicit (never "*"; https in
# production). TRUSTED_HOSTS is required in production. API docs are off in production.
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=
# API_DOCS_ENABLED=false
MAX_REQUEST_BODY_BYTES=1000000

# Retrieval used by POST /api/v1/doubts (an existing index generation; empty disables doubts).
RAG_EMBEDDING_MODEL=bge-m3
RAG_INDEX_GENERATION=
